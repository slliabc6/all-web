---
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";
import ProductGrid from "../components/product/ProductGrid.astro";
import { loadCurrentSite } from "../domain/current-site";
const bundle = await loadCurrentSite();
---

<SiteLayout bundle={bundle} title="Shop">
  <section class="catalog-page">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Shop" }]} />
    <div class="section-heading">
      <div><p class="eyebrow">Catalog</p><h1>All products</h1></div>
      <p>{bundle.products.length} products</p>
    </div>
    <ProductGrid products={bundle.products} currency={bundle.site.currency} columns={3} />
  </section>
</SiteLayout>
