---
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/navigation/Breadcrumbs.astro";
import { loadCurrentSite } from "../domain/current-site";
const bundle = await loadCurrentSite();
const isFurniture = bundle.site.catalogId === "small-batch-furniture";
---

<SiteLayout bundle={bundle} title="Wholesale & retail">
  <article class:list={["content-page", { "furniture-content": isFurniture }]}>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Wholesale & retail" }]} />
    <h1>{isFurniture ? "For rooms shaped with intent." : "Wholesale & retail"}</h1>
    <p>{isFurniture ? "We work with interior designers, small hospitality projects and independent retailers where the collection has room to breathe." : "Ask us about quantities, product options and current availability."}</p>
    <a class="button" href="/contact">{isFurniture ? "Discuss a project" : "Start an enquiry"}</a>
  </article>
</SiteLayout>
