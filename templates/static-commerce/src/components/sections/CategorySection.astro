---
import type { SiteBundle } from "../../domain/types";
interface Props { bundle: SiteBundle; variant: string }
const { bundle, variant } = Astro.props;
---

<section class="section category-section" data-section="categories" data-variant={variant}>
  <div class="section-copy">
    <p class="eyebrow">{variant === "atelier-index" ? "The collection" : "Browse"}</p>
    <h2>{variant === "atelier-index" ? "A few good things, made to stay." : "Shop by category"}</h2>
    {variant === "atelier-index" && <p>We release slowly. Each form earns its place through proportion, touch and everyday usefulness.</p>}
  </div>
  <div class="category-list">
    {bundle.categories.map((category, index) => (
      <a href={`/shop?category=${category.slug}`}><span>{String(index + 1).padStart(2, "0")}</span>{category.name.en}</a>
    ))}
  </div>
</section>
